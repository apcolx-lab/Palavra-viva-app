{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Camada3 Key Verse Study Schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractVersion",
    "id",
    "verseRef",
    "studyText"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "contractVersion": { "type": "string" },
    "id": { "type": "string" },
    "verseRef": { "type": "string" },
    "_teste": { "type": "boolean" },
    "humanReviewed": { "type": "boolean" },
    "studyText": { "type": "string" },
    "lineage": {
      "type": "object",
      "properties": {
        "generator": { "type": "string" },
        "auditor1": { "type": "string" },
        "auditor2": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
