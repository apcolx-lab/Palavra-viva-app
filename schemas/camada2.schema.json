{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Camada2 Passage Schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractVersion",
    "id",
    "passageRef",
    "openingQuestion",
    "whatTextSays",
    "gospelConnection",
    "application",
    "prayer"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "contractVersion": { "type": "string" },
    "id": { "type": "string" },
    "passageRef": { "type": "string" },
    "_teste": { "type": "boolean" },
    "humanReviewed": { "type": "boolean" },
    "gospelConnectionType": { "type": "integer", "minimum": 1, "maximum": 4 },
    "openingQuestion": { "type": "string" },
    "whatTextSays": { "type": "string" },
    "gospelConnection": { "type": "string" },
    "application": { "type": "string" },
    "prayer": { "type": "string" },
    "lineage": {
      "type": "object",
      "properties": {
        "generator": { "type": "string" },
        "auditor1": { "type": "string" },
        "auditor2": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
